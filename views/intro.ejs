<!DOCTYPE html>
<html lang="hi">
  <%- include("partials/head") %>

<body>

  <!-- =========================
       NAVBAR
  ========================== -->

  <header class="topbar">

    <a class="brand" href="/">
      <span class="brand-name">
        💧 WATER BUY OR SELL
      </span>

      <span class="brand-sub">
        (पानी का ऑर्डर दे या ले)
      </span>
    </a>

    <nav class="nav-links">

      <a href="/plantlogin">
        Seller Login (पानी बेचने वाला)
      </a>

      <a href="/buyerlogin">
        Buyer Login (पानी का खरीदार)
      </a>

      <a href="/signup" class="signup-btn">
        Signup (खाता बनाएं)
      </a>

      <a
      href="https://drive.google.com/file/d/1XDZW5mYhWx5jpFHkMPJ3qkBFPHGR5f3o/view?usp=sharing"
      class="apk-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      📱 APK Install Kare 👆🏼
    </a>

    </nav>

  </header>


  <!-- =========================
       HERO
  ========================== -->

  <section class="hero">

    <!-- LEFT CONTENT -->

    <div class="hero-left">

      <div class="hero-badge">
        -> Local water distributors ko customers se seedha jodta hai
      </div>

      <h1 class="hero-main-title">
        पानी का कैन,<br>
        बोतल, सभी यहाँ हैं
      </h1>

     
    </div>


    <!-- TEXT JUST BELOW BOTTLE CAP -->

    <div class="hero-bottle-text">
      अपने आस-पास के भरोसेमंद water plant से
      सीधे पानी की बोतल ऑर्डर करें।
    </div>


    <!-- RIGHT BUTTONS -->

    <div class="hero-actions">

      <a
        class="hero-action primary"
        href="/buyerRegister"
      >
        Buyer Signup ( खरीदार खाता बनाएँ )
      </a>

      <a
        class="hero-action secondary"
        href="/plantRegister"
      >
       Seller Signup ( विक्रेता खाता बनाएँ )
      </a>
      <a
      class="hero-action tertiary"
      href="/help"
    >
     For Help? ( संपर्क करें )
    </a>

    </div>

  </section>

</body>
</html>