<!DOCTYPE html>
<html lang="hi">
  <%- include("partials/head") %>
<body class="admin-page">
  <div class="topbar">
    <a class="brand" href="/"><span class="display" style="font-size:20px; font-weight:700; color:var(--ink);">💧 PaniWaleBhaiya</span></a>
  </div>
  <div class="wrap-narrow">
    <div class="admin-content">
    <h1 class="page-title">Admin Login</h1>
    <p class="page-sub">Platform status dekhne ke liye login karo</p>

    <% if (errState) { %><div class="msg err">Password galat hai.!</div><% } %>

    <form action="/admin/login_submit" method="post">
      <label>Admin Password</label>
      <input type="password" name="password" required />
      <input type="submit" value="Login" />
    </form>
  </div>
  </div>
</body>
</html>